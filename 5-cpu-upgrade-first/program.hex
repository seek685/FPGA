FFF00093   // addi  x1, x0, -1    -> x1  = FFFFFFFF   造常数-1, 兼测ADDI负立即数(instr[30]=1)
0000A133   // slt   x2, x1, x0    -> x2  = 00000001   有符号 -1 < 0
0000B1B3   // sltu  x3, x1, x0    -> x3  = 00000000   无符号 FFFFFFFF 是最大值
00002203   // lw    x4, 0(x0)     -> x4  = F0000000   dmem[0]
00402283   // lw    x5, 4(x0)     -> x5  = 00000004   dmem[1]
40525333   // sra   x6, x4, x5    -> x6  = FF000000   算术右移4位, 高位补符号位1
005253B3   // srl   x7, x4, x5    -> x7  = 0F000000   逻辑右移4位, 高位补0
00521433   // sll   x8, x4, x5    -> x8  = 00000000   左移4位, 高位全部移出
00221493   // slli  x9, x4, 2     -> x9  = C0000000
00225513   // srli  x10, x4, 2    -> x10 = 3C000000
40225593   // srai  x11, x4, 2    -> x11 = FC000000   高位补2个符号位
FFF1E613   // ori   x12, x3, -1   -> x12 = FFFFFFFF   立即数符号扩展为全1
FFF17693   // andi  x13, x2, -1   -> x13 = 00000001
FFF14713   // xori  x14, x2, -1   -> x14 = FFFFFFFE   1 ^ FFFFFFFF
FFF2B793   // sltiu x15, x5, -1   -> x15 = 00000001   4 < FFFFFFFF(无符号比较)
0020C833   // xor   x16, x1, x2   -> x16 = FFFFFFFE   R型XOR
0000A893   // slti  x17, x1, 0    -> x17 = 00000001    SLTI, -1 < 0
00000063   // beq   x0, x0, 0     -> 死循环停机
