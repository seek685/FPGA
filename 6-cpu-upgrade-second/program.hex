FFF00093   // 0x00: addi x1, x0, -1    -> x1 = FFFFFFFF
0000C463   // 0x04: blt  x1, x0, L1    -> -1 < 0 (signed), 跳 +8
00000093   // 0x08: addi x1, x0, 0     -> 被跳过
FFE00093   // 0x0C: L1: addi x1, x0, -2 -> x1 = FFFFFFFE
0000E463   // 0x10: bltu x1, x0, L2    -> FFFFFFFE 是无符号大数, 不跳
00200113   // 0x14: addi x2, x0, 2     -> 不应被跳过, x2 = 2
00600113   // 0x18: L2: addi x2, x0, 6 -> 注意: x2 被覆盖 = 6   
00002183   // 0x1C: lw   x3, 0(x0)     -> x3 = dmem[0] = 9
00402203   // 0x20: lw   x4, 4(x0)     -> x4 = dmem[1] = 9
00802283   // 0x24: lw   x5, 8(x0)     -> x5 = dmem[2] = 8
00418463   // 0x28: beq  x3, x4, L3    -> 9 == 9, 跳 +8
00620193   // 0x2C: addi x3, x4, 6     -> 被跳过
FFF20193   // 0x30: L3: addi x3, x4, -1 -> x3 = 9 - 1 = 8
00519863   // 0x34: bne  x3, x5, L4    -> 8 == 8, 不跳 (L4=末尾死循环)
0051F463   // 0x38: bgeu x3, x5, L5    -> 8 >= 8, 跳 +8
FF018293   // 0x3C: addi x5, x3, -16   -> 被跳过
0042D263   // 0x40: L5: bge x5, x4, L6 -> 8 < 9 (signed), 不跳 (L6=末尾死循环)
00000063   // 0x44: L4/L6: beq x0, x0, 0 -> 死循环停机
